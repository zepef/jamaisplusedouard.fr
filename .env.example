# Supabase (commentaires, newsletter, soumissions)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Tavily (veille automatisée — scripts/veille-cron.py)
# REQUIS sur l'hôte du cron Hermes : sans cette clé, le script saute la collecte (401).
TAVILY_API_KEY=tvly-xxxxxxxxxxxx

# Resend (email)
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=noreply@jamaisplusedouard.fr

# Site URL
NEXT_PUBLIC_SITE_URL=https://jamaisplusedouard.fr

# PostgreSQL — utilisé uniquement par drizzle-kit (doc/migrations du schéma)
DATABASE_URL=postgresql://user:password@host:5432/jamaisplusedouard
